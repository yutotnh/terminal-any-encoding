  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test:unit": "node --test out/test/*.test.js",
    "pretest:unit": "npm run compile",
    "lint": "eslint src && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "node out/test/runTest.js",
    "pretest:integration": "npm run compile",
    "package": "vsce package",
    "package:local": "bash transcoder/scripts/build.sh && mkdir -p transcoder/bin && cp transcoder/src/luit transcoder/bin/luit && npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@types/vscode": "1.73.0",
    "@vscode/iconv-lite-umd": "0.7.1",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-n": "^18.4.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "mocha": "^11.8.0",
    "ovsx": "^1.2.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "enabledApiProposals": [
    "terminalDataWriteEvent"
  ],
  "bugs": {
    "url": "https://github.com/yutotnh/terminal-any-encoding/issues"
  },
  "homepage": "https://github.com/yutotnh/terminal-any-encoding#readme",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "terminalAnyEncoding.shellProfile.linux",
        "terminalAnyEncoding.shellProfile.osx"
      ]
    }
  },
  "overrides": {
    "serialize-javascript": "^7.1.2"
  }
}
