{
  "name": "terminal-any-encoding",
  "displayName": "Terminal Any Encoding",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "yutotnh",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.73.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "encoding",
    "charset",
    "non-utf-8",
    "mojibake",
    "shift_jis",
    "euc-jp",
    "gbk",
    "gb18030",
    "gb2312",
    "big5",
    "big5-hkscs",
