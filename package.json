    "terminal": {
      "profiles": [
        {
          "id": "terminalAnyEncoding.select",
          "title": "🌐 Select Encoding...",
          "icon": "globe"
        },
        {
          "id": "terminalAnyEncoding.default",
          "title": "🌐 Default Encoding",
          "icon": "globe"
        }
      ]
    }
