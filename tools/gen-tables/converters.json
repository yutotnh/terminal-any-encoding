{
  "$comment": "The transcoder's built-in charset tables, generated from iconv-lite, the library VS Code decodes and encodes files with, in the package and version VS Code ships (@vscode/iconv-lite-umd, pinned by package-lock.json). A table named like one of upstream's (iso8859-*, koi8-*, ...) replaces it. encode_corrections: what a character is sent as where iconv-lite's encoder doesn't give back the bytes it was decoded from.",
  "encode_corrections": {
    "eucjp": {
      "U+FF5E": "a1c1",
      "U+2116": "ade2",
      "U+301C": "a1c1"
    },
    "shiftjis": {
      "U+301C": "8160"
    },
    "$comment": "iconv-lite saves EUC-JP's ～ (decoded from 0xA1C1) as 0x8FA2B7 and № (from 0xADE2) as 0x8FA2F1, which other tools can't read (VS Code issue #48802, iconv-lite #145; the wave-dash-unify extension corrects it on save). With these, every EUC-JP character with several byte sequences is sent as glibc's EUC-JP-MS sends it. U+301C, which iconv-lite can't encode, is the wave dash."
  },
  "tables": [
    {
      "name": "jisx0208-2007-0",
      "encoding": "eucjp",
      "plane": "g1",
      "comment": "EUC-JP's G1 (JIS X 0208 with NEC and IBM extensions). Its own name keeps stock eucJP's jisx0208.1990-0 untouched.",
      "overrides": [
        {
          "source": "0x2141",
          "target": "0x301C",
          "comment": "Wave dash (U+301C) for display, not the editor's U+FF5E: what JIS X 0208 means there, and what glibc's EUC-JP and Shift_JIS decode it to."
        }
      ]
    },
    {
      "name": "jisx0212.1990-0",
      "encoding": "eucjp",
      "plane": "g3",
      "comment": "EUC-JP's G3 (JIS X 0212, SS3 0x8F)."
    },
    {
      "name": "jisx0201.1976-0",
      "encoding": "eucjp",
      "plane": "kana",
      "comment": "EUC-JP's G2: JIS X 0201's half-width katakana (SS2 0x8E). Only the GR half; no supported encoding uses JIS-Roman."
    },
    {
      "name": "cp932-direct-0",
      "encoding": "shiftjis",
      "plane": "raw2byte",
      "comment": "Shift JIS as VS Code reads it (CP932), keyed on the raw bytes (other_ja.c): SJIS's coordinate formula can't handle the IBM extension rows.",
      "overrides": [
        {
          "source": "0x8160",
          "target": "0x301C",
          "comment": "Wave dash (U+301C) for display, not the editor's U+FF5E: what JIS X 0208 means there, and what glibc's EUC-JP and Shift_JIS decode it to."
        }
      ]
    },
    {
      "name": "gbk-0",
      "encoding": "gbk",
      "plane": "raw2byte",
      "comment": "GBK, keyed on the raw bytes (other_ja.c)."
    },
    {
      "name": "gb18030-2byte-0",
      "encoding": "gb18030",
      "plane": "raw2byte",
      "comment": "GB18030's 1- and 2-byte part, keyed on the raw bytes (other_ja.c); the 4-byte part is gb18030_ranges.c."
    },
    {
      "name": "big5hkscs-0",
      "encoding": "big5hkscs",
      "plane": "raw2byte",
      "comment": "Big5-HKSCS, keyed on the raw bytes (other_ja.c)."
    },
    {
      "name": "big5.eten-0",
      "encoding": "cp950",
      "plane": "raw2byte",
      "comment": "Big5 as VS Code reads it (CP950), for the \"Big 5\" charset (T_94192, keyed on the raw 2 bytes)."
    },
    {
      "name": "cp949-0",
      "encoding": "euckr",
      "plane": "raw2byte",
      "comment": "EUC-KR as VS Code reads it (CP949, i.e. EUC-KR plus Unified Hangul Code), keyed on the raw bytes (other_ja.c)."
